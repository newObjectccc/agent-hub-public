{
  "port": 7700,
  "host": "127.0.0.1",
  "sessionDir": "~/.pi/agent/sessions",
  "workspaceRoot": "~/Workspace",
  "kpiRefreshMinutes": 5,
  "auth": {
    "enabled": false,
    "token": ""
  },
  "claudeDriver": {
    "enabled": true,
    "defaultPolicy": "active-only",
    "idleDetachMs": 1800000,
    "maxConcurrent": 3,
    "mirror": "tmux",
    "externalQuietMs": 3000
  }
}
