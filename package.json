{
  "name": "@newobjectcccddd/agent-hub",
  "version": "0.3.0-beta.1",
  "description": "Cross-platform pi/claude agent session hub: mobile PWA panel + chat + KPI, with Node server, pi extensions and CLI",
  "license": "MIT",
  "author": "newObjectccc",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "agent-hub": "cli/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "cli/*.js",
    "cli/package.json",
    "cli/lib/*.js",
    "cli/lib/*.d.ts",
    "config/hub.config.example.json",
    "config/kpi-sources.json",
    "docs/API_CONTRACT.md",
    "docs/ARCHITECTURE.md",
    "docs/CLAUDE_DRIVER.md",
    "docs/CODEX_DRIVER.md",
    "docs/PLATFORM.md",
    "docs/HEADSCALE.md",
    "integrations/claude-perm-bridge/bridge.mjs",
    "integrations/pi-command/command.ts",
    "integrations/pi-live-feed/live-feed.ts",
    "server/dist/*.js",
    "server/dist/adapters/*.js",
    "server/dist/sessions/*.js",
    "web/dist",
    "SECURITY.md",
    "docs/INSTALL.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newObjectccc/agent-hub.git"
  },
  "homepage": "https://github.com/newObjectccc/agent-hub#readme",
  "bugs": {
    "url": "https://github.com/newObjectccc/agent-hub/issues"
  },
  "keywords": [
    "agent",
    "pi",
    "claude",
    "session-hub",
    "pwa",
    "self-hosted",
    "remote-control"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --workspace-concurrency=1 -r test && pnpm test:codex-lab",
    "test:codex-lab": "node --test docs/examples/codex-app-server-lab/*.test.mjs",
    "lint": "pnpm -r lint",
    "dev": "node cli/dev.js",
    "setup": "node cli/setup.js",
    "autostart": "node cli/setup.js --autostart",
    "start": "node cli/start.js",
    "remote": "node cli/remote.js",
    "doctor": "node cli/check.js",
    "check": "node cli/check.js",
    "prepublishOnly": "pnpm -r build && node scripts/pack-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.2.0",
    "ws": "^8.18.0"
  },
  "workspaces": [
    "server",
    "web",
    "cli",
    "integrations/pi-live-feed",
    "integrations/pi-command"
  ]
}
