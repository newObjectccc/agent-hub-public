{
  "name": "agent-hub",
  "version": "0.3.0",
  "description": "Cross-platform pi/claude agent session hub: mobile PWA panel + chat + KPI, with Node server, pi extensions and CLI",
  "license": "MIT",
  "author": "newObjectccc",
  "bin": {
    "agent-hub": "cli/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.en.md",
    "cli",
    "config/hub.config.example.json",
    "config/kpi-sources.json",
    "docs",
    "integrations/claude-perm-bridge/bridge.mjs",
    "integrations/pi-command/command.ts",
    "integrations/pi-live-feed/live-feed.ts",
    "server/dist",
    "web/dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newObjectccc/agent-hub.git"
  },
  "homepage": "https://github.com/newObjectccc/agent-hub#readme",
  "bugs": {
    "url": "https://github.com/newObjectccc/agent-hub/issues"
  },
  "keywords": [
    "agent",
    "pi",
    "claude",
    "session-hub",
    "pwa",
    "self-hosted",
    "remote-control"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --workspace-concurrency=1 -r test && pnpm test:codex-lab",
    "test:codex-lab": "node --test docs/examples/codex-app-server-lab/*.test.mjs",
    "lint": "pnpm -r lint",
    "dev": "node cli/dev.js",
    "setup": "node cli/setup.js",
    "autostart": "node cli/setup.js --autostart",
    "start": "node cli/start.js",
    "remote": "node cli/remote.js",
    "doctor": "node cli/check.js",
    "check": "node cli/check.js",
    "prepublishOnly": "pnpm -r build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.2.0",
    "ws": "^8.18.0"
  }
}
